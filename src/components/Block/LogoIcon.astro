---
import { getLogosSpriteURL } from '@src/pages/assets/icons/logos.svg';

interface Props {
	icon: string;
	size?: number;
	className?: string;
}

const { icon = 'default', size = 24, className = 'logo' } = Astro.props;

const iconRef = icon.replace(' ', '-').replace('rvm', 'ruby');
const iconURL = await getLogosSpriteURL();
---

<svg xmlns="http://www.w3.org/2000/svg" class={className} width={size} height={size}>
	<use href={`${iconURL}#${iconRef}`}></use>
</svg>
